# ShellCheck configuration. Committed, because behaviour that depends on a
# per-developer setting is not a standard (constitution, Principle V).

# The load-bearing line. Without it ShellCheck assumes bash and every bashism
# passes -- which would make Principle IV unenforceable by the tooling that
# exists to enforce it.
shell=sh

# Every finding fails the check. A laxer severity would let style findings pass
# silently, which contradicts FR-005: non-zero when a violation is found.
severity=style

# Follow the sourced helpers in scripts/lib/ so their definitions are checked in
# context, instead of producing "cannot follow source" on every runner.
external-sources=true
source-path=SCRIPTDIR

# Optional checks, chosen rather than blanket-enabled.
#
# `enable=all` is deliberately NOT used: it includes require-double-brackets,
# which mandates [[ ]] -- a bashism, and therefore in direct conflict with
# shell=sh above. The four below each prevent a defect the others do not.

# An unhandled case branch in tool resolution is a silent no-op, which is
# exactly what Principle II forbids.
enable=add-default-case

# Finds the places where an exit status is swallowed. Principle II, mechanically.
enable=check-extra-masked-returns

# set -e not applying inside a function call is the classic way fail-fast quietly
# stops being fail-fast.
enable=check-set-e-suppressed

# `command -v` is POSIX; `which` is not, and its exit status is unreliable.
enable=deprecate-which

# --- The shell check's excluded paths ----------------------------------------
#
# Every other check declares its excluded paths in the configuration file that
# drives it. ShellCheck has no such mechanism, and the block below is this
# repository's answer to that -- not a gap nobody wrote down.
#
# .shellcheckrc accepts shell, severity, source-path, external-sources, enable
# and disable. Every one is a directive about rules or interpretation; none is
# about which files to visit. The `-e`/`--exclude` flag excludes warning CODES,
# not paths -- a reader who assumes otherwise from the name gets silent
# under-checking rather than an error. See research.md section 13.
#
# So the paths are declared here as a marked comment block. ShellCheck ignores
# comments, which makes the block inert to the tool and authoritative for the
# runner: `extract_shellcheck` in scripts/lib/scope.sh reads it and
# scripts/lint-shell.sh excludes what it names. Declaring them in a committed
# configuration file at a documented path is what Principle V requires; a list
# inside lint-shell.sh would not be one, and was rejected on that ground
# (research.md section 12).
#
# KNOWN LIMITATION, and it cannot be fixed from here: a contributor running
# `shellcheck` by hand does NOT get these exclusions, because the tool has no
# way to read them. Every other check's declaration is read by the tool itself
# and so applies to a hand invocation too. This one applies to the runner only.
# That was equally true before the exclusions were written down here.
#
# scripts/ MUST NOT appear below. The constitution requires every script under
# the script directory to be subject to the shell check, and the format hook
# lives there.
#
# The markers are literal and are matched anchored. Editing a marker line
# breaks the extraction loudly rather than silently -- scope.sh refuses to run
# with no exclusions rather than widening the check's scope in silence.
# lint-exclude-begin
# .git
# .specify/scripts
# .specify/templates
# .specify/integrations
# .specify/workflows
# .specify/extensions
# .specify/.gitignore
# .specify/init-options.json
# .specify/integration.json
# .specify/memory/.constitution-template.json
# .claude
# LEAN-CTX.md
# .remember
# node_modules
# .venv
# venv
# .ruff_cache
# __pycache__
# .lint-selftest-tmp
# lint-exclude-end
